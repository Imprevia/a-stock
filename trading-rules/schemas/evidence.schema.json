{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-stock.local/schemas/trading-evidence-manifest.json",
  "title": "Trading evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "createdAt", "asOf", "status", "ruleSet", "ruleSetVersion", "gitSha", "providerStatus", "warnings", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "asOf": {"type": "string", "format": "date"},
    "status": {"enum": ["ok", "degraded", "insufficient", "failed"]},
    "ruleSet": {"type": "string"},
    "ruleSetVersion": {"type": "integer", "minimum": 1},
    "gitSha": {"type": "string", "minLength": 1},
    "providerStatus": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}

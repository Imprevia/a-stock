{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-stock.local/schemas/trading-event.json",
  "title": "Structured trading event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "source", "sourceType", "publishedAt", "recordedAt", "direction", "scope", "mappings", "expiresAt", "invalidation"],
  "properties": {
    "eventId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]+$"},
    "source": {"type": "string", "minLength": 1},
    "sourceType": {"enum": ["official", "exchange", "company", "traceable-media", "social", "unverified"]},
    "publishedAt": {"type": "string", "format": "date-time"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "direction": {"enum": ["positive", "negative", "mixed", "neutral"]},
    "scope": {"enum": ["market", "sector", "security"]},
    "mappings": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "expiresAt": {"type": "string", "format": "date-time"},
    "invalidation": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-stock.local/schemas/trading-rule-set.json",
  "title": "Trading rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleSet", "version", "rules"],
  "properties": {
    "ruleSet": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId", "version", "title", "status", "scope", "evaluator",
        "inputs", "windows", "parameters", "thresholds", "scoring",
        "vetoes", "missingData", "outputs", "documentRefs", "evidenceRefs"
      ],
      "properties": {
        "ruleId": {"type": "string", "pattern": "^QTS-[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
        "version": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "defined", "backtested", "validated", "retired"]},
        "scope": {"enum": ["market", "sector", "security", "account", "behavior", "event", "review"]},
        "evaluator": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "inputs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"},
          "uniqueItems": true
        },
        "windows": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "parameters": {"type": "object"},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "bands"],
          "properties": {
            "provenance": {"enum": ["fixed", "empirical-initial", "rolling-calibration", "validated"]},
            "bands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["score"],
                "properties": {
                  "lte": {"type": "number"},
                  "lt": {"type": "number"},
                  "gte": {"type": "number"},
                  "gt": {"type": "number"},
                  "equals": {},
                  "score": {"enum": [0, 25, 50, 75, 100]}
                }
              }
            }
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight", "direction"],
          "properties": {
            "weight": {"type": "number", "minimum": 0, "maximum": 1},
            "direction": {"enum": ["positive", "negative", "neutral"]}
          }
        },
        "vetoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "operator", "value", "reason"],
            "properties": {
              "input": {"type": "string"},
              "operator": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "truthy", "falsy"]},
              "value": {},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "missingData": {"enum": ["insufficient", "reduce-confidence", "skip"]},
        "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "documentRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}

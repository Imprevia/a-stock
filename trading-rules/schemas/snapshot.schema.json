{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-stock.local/schemas/trading-snapshot.json",
  "title": "Canonical trading snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "createdAt", "status", "providerQuality", "metrics", "events", "warnings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "asOf": {"type": "string", "format": "date"},
    "createdAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "degraded", "insufficient"]},
    "providerQuality": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset", "provider", "status", "observations", "warnings"],
        "properties": {
          "dataset": {"type": "string"},
          "provider": {"type": "string"},
          "status": {"enum": ["ok", "fallback", "failed", "missing"]},
          "observations": {"type": "integer", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "boolean", "string", "null"]}
    },
    "events": {"type": "array", "items": {"$ref": "event.schema.json"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}

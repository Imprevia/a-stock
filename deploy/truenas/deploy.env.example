# Copy this file to deploy/truenas/deploy.env on the 1.21 VM.
# Values are shell assignments. Keep this file private if it contains local paths.

REPO_DIR=/home/gyt/a-stock
# Repository updates are a separate operator step. The deployment entry point
# rejects true so it can validate one stable checkout before any network access.
GIT_UPDATE=false

# SSH endpoint for the TrueNAS host running k3s.
TRUENAS_HOST=192.168.1.20
TRUENAS_SSH_USER=admin
TRUENAS_SSH_PORT=22

# Keep the k3s API private on TrueNAS and access it through an SSH loopback
# tunnel. The SSH account must be allowed to forward to 127.0.0.1:6443.
K3S_API_SSH_TUNNEL=true
K3S_API_LOCAL_PORT=16443

# A writable TrueNAS dataset used for image archives.
REMOTE_IMAGE_DIR=/mnt/tank/app-builds/a-stock

# Must match the image imported into k3s containerd.
IMAGE_REPOSITORY=localhost/a-stock-market-environment
# Leave empty to derive a timestamp + git SHA tag.
IMAGE_TAG=
BUILD_PLATFORM=linux/amd64

NAMESPACE=a-stock
RELEASE_NAME=a-stock
# Required from server dry-run onward and compared with the live /version.
# Read-only discovery intentionally leaves this unset and reports the live value.
# TARGET_KUBERNETES_VERSION=1.26.6+k3s1
# Set this to a reviewed environment values file for clusters that use a
# static existing PVC or NodePort and do not provide Traefik/StorageClass.
HELM_VALUES_FILE=
INGRESS_CLASS=traefik
INGRESS_HOST=a-stock.k3s.lan

# Use 80 when Traefik is reachable at the TrueNAS node IP. For NodePort,
# set the HTTP nodePort shown by `kubectl -n kube-system get svc traefik`.
TRUENAS_INGRESS_PORT=80
STORAGE_CLASS=

# Ordinary application deployment proceeds only when the Helm stored manifest
# and live state contain no application CronJob. If an active or suspended
# CronJob exists in either view, first use a reviewed and authorized
# --disable-schedule packet. Use the explicit reviewed release modes below to
# create or activate a CronJob.
SCHEDULED_COLLECTION_ENABLED=false
SCHEDULED_COLLECTION_SUSPEND=true
# Optional reviewed scheduling overlay, layered after HELM_VALUES_FILE.
# SCHEDULING_OVERLAY_FILE=deploy/truenas/values-scheduled-suspended.yaml
# Exact admission uses only `create cronjobs.batch` with dryRun=All and rejects
# active/off overlays or any non-CronJob resource before kubectl is called.
SERVER_DRY_RUN_AUTHORIZED=false
SERVER_DRY_RUN_VERB=create

# Explicit production modes. All three reject a dirty/drifting checkout, reuse the
# frozen image, and require all reviewed hashes below.
SUSPENDED_RELEASE_AUTHORIZED=false
SCHEDULE_ACTIVATION_AUTHORIZED=false
SCHEDULE_ROLLBACK_AUTHORIZED=false
# These references must identify the review record that authorizes the exact
# Gate B packet, post-evidence Gate C operation, or exact disable-schedule
# command. The rollback reference is rollback-v1:<approval-id>:<binding-sha256>;
# its digest covers the runbook's ordered canonical payload and must be
# independent from Gate B/Gate C. Boolean flags and progression permission are
# not operation authorization.
GATE_B_AUTHORIZATION_REF=
GATE_C_AUTHORIZATION_REF=
SCHEDULE_ROLLBACK_AUTHORIZATION_REF=
# Gate C must explicitly select next-schedule or immediate-catch-up. The entry
# point rejects next-schedule inside the 1800-second missed-run window or within
# 300 seconds of the next trigger; immediate-catch-up is valid only in that window.
GATE_C_CATCH_UP_MODE=
REVIEWED_GIT_HEAD=
REVIEWED_CHART_SHA256=
REVIEWED_BASELINE_SHA256=
REVIEWED_OVERLAY_SHA256=
REVIEWED_RENDER_SHA256=
FROZEN_IMAGE_REPOSITORY=localhost/a-stock-market-environment
FROZEN_IMAGE_TAG=
FROZEN_IMAGE_DIGEST=

# The collection POST API has no authentication. Keep it disabled when the
# dashboard is exposed through Tailscale unless an auth boundary is present.
DISABLE_MANUAL_REFRESH=true

# Only used for the completion message.
TAILSCALE_HOST=gyt.tail0007b1.ts.net
TAILSCALE_PORT=8443
HELM_TIMEOUT=5m

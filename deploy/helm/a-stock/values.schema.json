{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "component": {
      "type": "string",
      "enum": [
        "all",
        "database",
        "service"
      ],
      "description": "Component intent for the componentized TrueNAS k3s entry point. `all` preserves the existing one-click behaviour; `database` and `service` constrain rendering to the matching subset of resources."
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "secretKeys": {
          "type": "object",
          "required": ["url", "username", "password", "database"],
          "properties": {
            "url": {"type": "string", "minLength": 1},
            "username": {"type": "string", "minLength": 1},
            "password": {"type": "string", "minLength": 1},
            "database": {"type": "string", "minLength": 1}
          }
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "pullPolicy": {"type": "string"}
          }
        },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "storageClass": {"type": "string"},
            "size": {"type": "string"},
            "keep": {"type": "boolean"}
          }
        },
        "migration": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "sourceClaim": {"type": "string"},
            "sourcePath": {"type": "string"},
            "backupPath": {"type": "string"},
            "apply": {"type": "boolean"},
            "schemaEnabled": {"type": "boolean"}
          }
        }
      }
    },
    "marketEnvironment": {
      "type": "object",
      "required": [
        "timezone",
        "automationRefreshEnabled"
      ],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "enum": [
            "Asia/Shanghai"
          ]
        },
        "automationRefreshEnabled": {
          "type": "boolean"
        },
        "persistentCache": {
          "type": "boolean"
        },
        "snapshotPath": {
          "type": "string"
        },
        "settlementTime": {
          "type": "string",
          "pattern": "^(?:[01]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "crawlFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "hosts"],
          "properties": {
            "enabled": {"type": "boolean"},
            "hosts": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "scrapling": {
          "type": "object",
          "required": ["enabled", "image", "allowlist"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {
              "type": "object",
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "minLength": 1},
                "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "allowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host", "sourceId"],
                "properties": {
                  "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 1},
                  "sourceId": {"type": "string", "pattern": "^\\S+$", "minLength": 1}
                }
              }
            }
          }
        },
        "tdx": {
          "type": "object",
          "properties": {
            "derivedActiveDirectionEnabled": {"type": "boolean"}
          }
        },
        "limits": {
          "type": "object",
          "required": ["v1Enabled", "fuyao"],
          "properties": {
            "v1Enabled": {"type": "boolean"},
            "fuyao": {
              "type": "object",
              "required": ["existingSecret", "secretKey"],
              "properties": {
                "existingSecret": {"type": "string"},
                "secretKey": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "fuyao": {
          "type": "object",
          "required": ["existingSecret", "secretKey", "ths", "datasets"],
          "properties": {
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1},
            "ths": {
              "type": "object",
              "additionalProperties": false,
              "required": ["writesAuthorized", "catalog", "membership", "history", "dumps"],
              "properties": {
                "writesAuthorized": {"type": "boolean"},
                "catalog": {"$ref": "#/definitions/fuyaoThsCapability"},
                "membership": {"$ref": "#/definitions/fuyaoThsCapability"},
                "history": {"$ref": "#/definitions/fuyaoThsCapability"},
                "dumps": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dailyEnabled", "incrementalEnabled", "adjustmentEnabled"],
                  "properties": {
                    "dailyEnabled": {"type": "boolean"},
                    "incrementalEnabled": {"type": "boolean"},
                    "adjustmentEnabled": {"type": "boolean"}
                  }
                }
              }
            },
            "datasets": {
              "type": "object",
              "required": ["core", "breadth", "sectors", "activeDirection"],
              "properties": {
                "core": {"$ref": "#/definitions/fuyaoDataset"},
                "breadth": {"$ref": "#/definitions/fuyaoDataset"},
                "sectors": {"$ref": "#/definitions/fuyaoDataset"},
                "activeDirection": {"$ref": "#/definitions/fuyaoDataset"}
              }
            }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "sslMode": {"type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]},
            "poolSize": {"type": "integer", "minimum": 1},
            "maxOverflow": {"type": "integer", "minimum": 0},
            "poolTimeoutSeconds": {"type": "integer", "minimum": 1},
            "statementTimeoutMs": {"type": "integer", "minimum": 100}
          }
        }
      }
    }
  },
  "definitions": {
    "fuyaoDataset": {
      "type": "object",
      "required": ["enabled", "approvedRevision", "shadowEnabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "approvedRevision": {"type": "string"},
        "shadowEnabled": {"type": "boolean"}
      }
    },
    "fuyaoThsCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "revision"],
      "properties": {
        "enabled": {"type": "boolean"},
        "revision": {"type": "string"}
      }
    }
  }
}

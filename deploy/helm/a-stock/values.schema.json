{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "marketEnvironment": {
      "type": "object",
      "required": [
        "timezone",
        "scheduledCollection"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "enum": [
            "Asia/Shanghai"
          ]
        },
        "scheduledCollection": {
          "type": "object",
          "required": [
            "enabled",
            "suspend",
            "controllerTimeZoneVerified",
            "controllerCanaryVerified"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "suspend": {
              "type": "boolean"
            },
            "controllerTimeZoneVerified": {
              "type": "boolean"
            },
            "controllerCanaryVerified": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}

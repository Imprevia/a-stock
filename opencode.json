{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "mcp": {
    "chrome-devtools": {
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "type": "local"
    },
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "xiaoyaoji-mcp-client": {
      "command": ["xiaoyaoji-mcp-server"],
      "enabled": true,
      "environment": {
        "MCP_API_URL": "http://192.168.14.218:3000"
      },
      "type": "local"
    }
  },
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "chitone-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{env:ZHITONG_ANTHROPIC_KEY}",
        "baseURL": "https://api.zhitong.work/v1"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "claude-opus-4-8",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 200000, "output": 32000 },
          "options": { "thinking": { "effort": "high" } }
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 200000, "output": 16000 }
        }
      }
    },
    "chitone-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ZHITONG_OPENAI_KEY}",
        "baseURL": "https://api.zhitong.work/v1"
      },
      "models": {
        "gpt-5.6-luna":  { "name": "GPT-5.6 Luna" },
        "gpt-5.6-sol":   { "name": "GPT-5.6 Sol" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra" }
      }
    },
    "chitone-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ZHITONG_GLM_KEY}",
        "baseURL": "https://api.zhitong.work/v1"
      },
      "models": {
        "glm-5.2": { "name": "GLM-5.2" }
      }
    },
    "chitone-google": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ZHITONG_GOOGLE_KEY}",
        "baseURL": "https://api.zhitong.work/v1"
      },
      "models": {
        "gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro Preview" },
        "gemini-3.5-flash":       { "name": "Gemini 3.5 Flash" }
      }
    }
  }
}

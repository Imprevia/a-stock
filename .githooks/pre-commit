#!/usr/bin/env sh
set -eu
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python scripts/check-test-gate.py --mode=commit
elif [ -x .venv/Scripts/python.exe ]; then
  exec .venv/Scripts/python.exe scripts/check-test-gate.py --mode=commit
elif command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/check-test-gate.py --mode=commit
elif command -v python >/dev/null 2>&1; then
  exec python scripts/check-test-gate.py --mode=commit
elif command -v py >/dev/null 2>&1; then
  exec py -3 scripts/check-test-gate.py --mode=commit
else
  echo '[test-gate] 缺少 Python，未验证；请安装 Python 后重试。' >&2
  exit 1
fi

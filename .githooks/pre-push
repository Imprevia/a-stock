#!/usr/bin/env sh
# 薄入口：真正规则在 scripts/check-docs-contract.py（保持本文件无业务逻辑）
# pre-push 通过 stdin 收到 ref range，这里直接比对 upstream，脚本内部自行回退基线
set -eu

cat >/dev/null 2>&1 || true

if command -v python >/dev/null 2>&1; then
  exec python scripts/check-docs-contract.py --mode=full
elif command -v py >/dev/null 2>&1; then
  exec py scripts/check-docs-contract.py --mode=full
else
  echo "[docs-contract] 未找到 python 解释器，跳过检查（建议安装 Python 3，见 docs/runbooks.md）" >&2
  exit 0
fi
